import Mathlib

namespace Mathforge.ApRySetsASSSMSOfNumericalSemigroupsSC4

open Finset

set_option maxRecDepth 100000
set_option maxHeartbeats 0

namespace C4Refute

/-- Membership in the monoid generated by the four arguments.
The coefficient of `m` is encoded by the final divisibility test. -/
def belongs (m a b d n : ℕ) : Prop :=
  ∃ x : Fin (n + 1), ∃ y : Fin (n + 1), ∃ z : Fin (n + 1),
    a * x.val + b * y.val + d * z.val ≤ n ∧
    (n - (a * x.val + b * y.val + d * z.val)) % m = 0

instance (m a b d n : ℕ) : Decidable (belongs m a b d n) :=
  inferInstanceAs (Decidable (∃ x : Fin (n + 1),
    ∃ y : Fin (n + 1), ∃ z : Fin (n + 1),
      a * x.val + b * y.val + d * z.val ≤ n ∧
      (n - (a * x.val + b * y.val + d * z.val)) % m = 0))

def minimal (m a b d : ℕ) : Prop :=
  ¬ belongs 0 a b d m ∧
  ¬ belongs m 0 b d a ∧
  ¬ belongs m a 0 d b ∧
  ¬ belongs m a b 0 d

def tail (m a b d c : ℕ) : Prop :=
  ∀ n, c ≤ n → belongs m a b d n

noncomputable def conductor (m a b d : ℕ) : ℕ := by
  classical
  exact if h : ∃ c, tail m a b d c then Nat.find h else 0

noncomputable def genus (m a b d : ℕ) : ℕ :=
  ((range (conductor m a b d)).filter
    (fun n => ¬ belongs m a b d n)).card

-- FAITHFULNESS:
-- The four universally quantified variables are integers. The order hypotheses
-- make every displayed generator positive, so toNat preserves its value.
-- The nested gcd is the gcd of all four integers. `belongs` encodes exactly
-- nonnegative linear combinations: three coefficients are bounded by n
-- (positive generators make these bounds harmless), and the remaining
-- coefficient is encoded by divisibility. With a zero argument, its coefficient
-- can be discarded; hence `minimal` tests membership in the other three
-- generators. `tail` is the conductor property, and `conductor` takes its least
-- solution. Its fallback is irrelevant under the positive, gcd-one hypotheses,
-- which ensure a numerical semigroup. `genus` counts precisely the missing
-- nonnegative integers below that conductor. The differences in the conclusion
-- and in the conductor-gap hypothesis are integer differences, not truncated
-- natural subtraction. The two monoids use d and d-m respectively.
theorem refutation :
    ¬ (∀ m a b d : ℤ,
      4 ≤ m →
      m < a →
      a < b →
      b < 2 * m →
      2 * m ≤ d →
      Nat.gcd (Nat.gcd (Nat.gcd m.natAbs a.natAbs) b.natAbs)
        d.natAbs = 1 →
      minimal m.toNat a.toNat b.toNat d.toNat →
      minimal m.toNat a.toNat b.toNat (d - m).toNat →
      (conductor m.toNat a.toNat b.toNat d.toNat : ℤ) -
        (conductor m.toNat a.toNat b.toNat (d - m).toNat : ℤ) ≥ m →
      4 * ((genus m.toNat a.toNat b.toNat d.toNat : ℤ) -
        (genus m.toNat a.toNat b.toNat (d - m).toNat : ℤ)) ≤
      3 * ((conductor m.toNat a.toNat b.toNat d.toNat : ℤ) -
        (conductor m.toNat a.toNat b.toNat (d - m).toNat : ℤ))) := by
  sorry

end C4Refute

end Mathforge.ApRySetsASSSMSOfNumericalSemigroupsSC4
