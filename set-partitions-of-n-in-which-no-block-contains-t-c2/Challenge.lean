import Mathlib

namespace Mathforge.SetPartitionsOfNInWhichNoBlockContainsTC2

open Finset

/-- Partitions of {1,...,r}, generated by inserting the new largest element. -/
def partitions : ℕ → Finset (Finset (Finset ℕ))
  | 0 => {∅}
  | r + 1 =>
      (partitions r).biUnion fun Q =>
        insert (insert {r + 1} Q)
          (Q.image fun B => insert (insert (r + 1) B) (Q.erase B))

def admissible (Q : Finset (Finset ℕ)) : Prop :=
  ∀ B ∈ Q, ∀ i ∈ B, i + 2 ∉ B

instance (Q : Finset (Finset ℕ)) : Decidable (admissible Q) :=
  inferInstanceAs (Decidable (∀ B ∈ Q, ∀ i ∈ B, i + 2 ∉ B))

def admissiblePartitions (r : ℕ) :=
  (partitions r).filter admissible

def singletons (Q : Finset (Finset ℕ)) : ℕ :=
  (Q.filter fun B => B.card = 1).card

def adjacencies (r : ℕ) (Q : Finset (Finset ℕ)) : ℕ :=
  ((range (r - 1)).filter fun i =>
    ∃ B ∈ Q, i + 1 ∈ B ∧ i + 2 ∈ B).card

def lhsCoeff (r p q t : ℕ) : ℕ :=
  ((admissiblePartitions r).filter fun Q =>
    Q.card = p ∧ singletons Q = q ∧ adjacencies r Q = t).card

def distinguished (m : ℕ) (Q : Finset (Finset ℕ)) :
    Finset (Option (Finset ℕ)) :=
  insert none
    ((Q.filter fun B => m - 1 ∉ B ∧ m ∉ B).image some)

def removed (D : Option (Finset ℕ)) : Finset (Finset ℕ) :=
  match D with
  | none => ∅
  | some B => {B}

def delta (D : Option (Finset ℕ)) : ℕ :=
  match D with
  | none => 0
  | some _ => 1

def choicesI (m : ℕ) (Q : Finset (Finset ℕ))
    (D : Option (Finset ℕ)) : Finset (Finset (Finset ℕ)) :=
  ((Q \ removed D).powerset).filter fun I =>
    ∀ B ∈ I, m ∉ B

def isMatching (M : Finset (Finset (Finset ℕ))) : Prop :=
  ∀ e ∈ M, ∀ f ∈ M, e ≠ f → Disjoint e f

instance (M : Finset (Finset (Finset ℕ))) : Decidable (isMatching M) :=
  inferInstanceAs
    (Decidable (∀ e ∈ M, ∀ f ∈ M, e ≠ f → Disjoint e f))

def matchings (A : Finset (Finset ℕ)) :
    Finset (Finset (Finset (Finset ℕ))) :=
  ((A.powerset.filter fun e => e.card = 2).powerset).filter isMatching

def unmatchedSingletons (A : Finset (Finset ℕ))
    (M : Finset (Finset (Finset ℕ))) : ℕ :=
  (A.filter fun B => B.card = 1 ∧ ∀ e ∈ M, B ∉ e).card

def rhsCoeff (m p q t : ℕ) : ℕ :=
  ∑ Q ∈ admissiblePartitions m,
    ∑ D ∈ distinguished m Q,
      ∑ I ∈ choicesI m Q D,
        ((matchings ((Q \ removed D) \ I)).filter fun M =>
          2 * Q.card - I.card - 2 * delta D + 1 = p ∧
          2 * unmatchedSingletons ((Q \ removed D) \ I) M + 1 - delta D = q ∧
          2 * adjacencies m Q = t).card

-- FAITHFULNESS:
-- `partitions r` enumerates each set partition of [r] exactly once: the block
-- containing r is obtained either as a new singleton or by insertion into
-- exactly one old block. `admissiblePartitions` excludes differences of two.
-- Q.card, singletons, and adjacencies implement b, s, and a respectively.
-- `distinguished` includes absence and precisely the eligible distinguished
-- blocks; `choicesI` enumerates all allowed subsets excluding the block of m.
-- `matchings` enumerates collections of disjoint two-element subsets of the
-- remaining blocks, including the empty matching. `unmatchedSingletons` is u.
-- Each coefficient counts summands with the specified three exponents.
-- These natural counts are the integer polynomial coefficients; equality
-- modulo two is equivalent to their integer difference being even.
-- The negated statement quantifies over every m ≥ 2 and every coefficient.

theorem refutation :
    ¬ (∀ m : ℕ, 2 ≤ m →
      ∀ p q t : ℕ,
        lhsCoeff (2 * m + 1) p q t % 2 =
          rhsCoeff m p q t % 2) := by
  sorry

end Mathforge.SetPartitionsOfNInWhichNoBlockContainsTC2
